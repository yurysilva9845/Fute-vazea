# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_WS_URL: Optional WebSocket endpoint URL for the 30Hz Authoritative Multiplayer Server (/ws/match).
# Useful when deploying the static frontend on Vercel while the Node.js WebSocket server runs on Cloud Run / Render / Railway.
# Example: wss://ais-pre-vjvg452vafw2n3arhxoh2l-129611115171.us-east1.run.app/ws/match
VITE_WS_URL=""

# VITE_SUPABASE_URL: URL pública do projeto Supabase PostgreSQL + Realtime.
# Exemplo: https://seu-projeto.supabase.co
VITE_SUPABASE_URL=""

# VITE_SUPABASE_PUBLISHABLE_KEY: Publishable Key (chave pública) do Supabase.
# IMPORTANTE: Nunca utilize a Secret Key (service_role) no navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=""


