{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Online player profile, status, friend tag, and career stats for SEM TERRA FC.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the user." },
        "displayName": { "type": "string", "description": "Visible nickname in the lobby and pitch." },
        "tagCode": { "type": "string", "description": "Short unique friend code (e.g. #VRZ1234)." },
        "status": {
          "type": "string",
          "enum": ["online", "in_room", "playing", "offline"],
          "description": "Current presence status."
        },
        "currentRoomCode": { "type": "string", "description": "Active room code if in a room." },
        "friends": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of friend UIDs."
        },
        "wins": { "type": "integer", "description": "Total matches won." },
        "losses": { "type": "integer", "description": "Total matches lost." },
        "draws": { "type": "integer", "description": "Total matches drawn." },
        "goalsScored": { "type": "integer", "description": "Total goals scored." },
        "goalsConceded": { "type": "integer", "description": "Total goals conceded." },
        "matchesPlayed": { "type": "integer", "description": "Total completed matches played." },
        "updatedAt": { "type": "timestamp", "description": "Last heartbeat server timestamp." },
        "createdAt": { "type": "timestamp", "description": "Account creation server timestamp." }
      },
      "required": [
        "uid",
        "displayName",
        "tagCode",
        "status",
        "currentRoomCode",
        "friends",
        "wins",
        "losses",
        "draws",
        "goalsScored",
        "updatedAt",
        "createdAt"
      ]
    },
    "MultiplayerRoom": {
      "title": "Multiplayer Room",
      "description": "Active 2v2 or 4v4 multiplayer match room with public/private visibility, slot assignments, and synchronized state.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "description": "6-8 character room code." },
        "roomName": { "type": "string", "description": "Display name of the room (e.g. SEM TERRA FC — SALA #102)." },
        "mode": {
          "type": "string",
          "enum": ["2v2", "4v4"],
          "description": "Match format: 2v2 (4 players) or 4v4 (8 players)."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Whether the room is publicly joinable or requires password/code."
        },
        "hasPassword": { "type": "boolean", "description": "True if private room requires password." },
        "passwordHash": { "type": "string", "description": "Salted SHA-256 hash of room password." },
        "maxHumans": { "type": "integer", "description": "Max human players allowed (up to 4 in 2v2, up to 8 in 4v4)." },
        "autoFillBots": { "type": "boolean", "description": "Whether bots automatically fill empty slots." },
        "activeCharacterIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Active character slot IDs for 2v2 or 4v4."
        },
        "loadingReadyUids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "UIDs that have completed pre-match loading synchronization."
        },
        "lastActivityMs": { "type": "integer", "description": "Epoch ms of last room heartbeat activity." },
        "hostUid": { "type": "string", "description": "UID of the room creator/host." },
        "hostName": { "type": "string", "description": "Display name of the host." },
        "status": {
          "type": "string",
          "enum": ["waiting", "playing", "finished"],
          "description": "Room lifecycle state."
        },
        "homeTeamId": { "type": "string" },
        "awayTeamId": { "type": "string" },
        "homeGoals": { "type": "integer" },
        "awayGoals": { "type": "integer" },
        "half": { "type": "integer" },
        "remainingSeconds": { "type": "integer" },
        "slots": {
          "type": "object",
          "description": "Map of character slot IDs to player/bot assignment."
        },
        "inputs": {
          "type": "object",
          "description": "Map of client UIDs to latest input packets."
        },
        "matchSnapshot": {
          "type": "object",
          "description": "Latest authoritative physics snapshot from host."
        },
        "updatedAt": { "type": "timestamp" },
        "createdAt": { "type": "timestamp" }
      },
      "required": [
        "roomCode",
        "hostUid",
        "hostName",
        "status",
        "homeTeamId",
        "awayTeamId",
        "homeGoals",
        "awayGoals",
        "half",
        "remainingSeconds",
        "slots",
        "updatedAt",
        "createdAt"
      ]
    },
    "VoiceSignal": {
      "title": "WebRTC Voice Signal",
      "description": "Peer-to-peer WebRTC signaling message (offer, answer, ice) inside a room.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "toUid": { "type": "string" },
        "type": { "type": "string", "enum": ["offer", "answer", "ice"] },
        "payload": { "type": "string", "description": "Serialized SDP or ICE candidate JSON." },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["fromUid", "toUid", "type", "payload", "createdAt"]
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Friend request or room invitation between two players.",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string" },
        "fromName": { "type": "string" },
        "fromTag": { "type": "string" },
        "toUid": { "type": "string" },
        "toName": { "type": "string" },
        "type": { "type": "string", "enum": ["friend_request", "room_invite"] },
        "roomCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": [
        "fromUid",
        "fromName",
        "fromTag",
        "toUid",
        "toName",
        "type",
        "roomCode",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MatchHistory": {
      "title": "Match History Record",
      "description": "Completed match summary and scorer log.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string" },
        "hostUid": { "type": "string" },
        "homeTeamName": { "type": "string" },
        "awayTeamName": { "type": "string" },
        "homeGoals": { "type": "integer" },
        "awayGoals": { "type": "integer" },
        "winner": { "type": "string", "enum": ["home", "away", "draw"] },
        "participantUids": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "timestamp" }
      },
      "required": [
        "roomCode",
        "hostUid",
        "homeTeamName",
        "awayTeamName",
        "homeGoals",
        "awayGoals",
        "winner",
        "participantUids",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Player profiles indexed by Auth UID."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/MultiplayerRoom" },
      "description": "Multiplayer rooms indexed by roomCode."
    },
    "/rooms/{roomId}/signals/{signalId}": {
      "schema": { "$ref": "#/entities/VoiceSignal" },
      "description": "WebRTC peer-to-peer signaling messages for room voice chat."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend requests and room invitations."
    },
    "/matchHistory/{matchId}": {
      "schema": { "$ref": "#/entities/MatchHistory" },
      "description": "Completed match history logs."
    }
  }
}
