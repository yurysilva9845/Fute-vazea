rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestampOrInt(val) {
      return val is timestamp || val is int || val is float;
    }

    function isValidNumberInRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'tagCode', 'status', 'currentRoomCode',
          'friends', 'wins', 'losses', 'draws', 'goalsScored',
          'updatedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'tagCode', 'status', 'currentRoomCode',
          'friends', 'wins', 'losses', 'draws', 'goalsScored',
          'goalsConceded', 'matchesPlayed',
          'updatedAt', 'createdAt'
        ])
        && data.uid is string && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.tagCode is string && data.tagCode.size() >= 2 && data.tagCode.size() <= 24
        && data.status in ['online', 'in_room', 'playing', 'offline']
        && data.currentRoomCode is string && data.currentRoomCode.size() <= 32
        && data.friends is list && data.friends.size() <= 500
        && isValidNumberInRange(data.wins, 0, 100000)
        && isValidNumberInRange(data.losses, 0, 100000)
        && isValidNumberInRange(data.draws, 0, 100000)
        && isValidNumberInRange(data.goalsScored, 0, 500000)
        && (!('goalsConceded' in data) || isValidNumberInRange(data.goalsConceded, 0, 500000))
        && (!('matchesPlayed' in data) || isValidNumberInRange(data.matchesPlayed, 0, 300000))
        && isValidTimestampOrInt(data.updatedAt)
        && isValidTimestampOrInt(data.createdAt);
    }

    function isValidMultiplayerRoom(data, roomId) {
      return data.keys().hasAll([
          'roomCode', 'hostUid', 'hostName', 'status',
          'homeTeamId', 'awayTeamId', 'homeGoals', 'awayGoals',
          'half', 'remainingSeconds', 'slots', 'updatedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'matchId', 'roomName', 'mode', 'visibility', 'hasPassword', 'passwordHash',
          'maxHumans', 'autoFillBots', 'activeCharacterIds', 'loadingReadyUids', 'startAt', 'lastActivityMs',
          'hostUid', 'hostName', 'status',
          'homeTeamId', 'awayTeamId', 'homeGoals', 'awayGoals',
          'half', 'remainingSeconds', 'slots', 'inputs', 'matchSnapshot',
          'updatedAt', 'createdAt'
        ])
        && data.roomCode is string && data.roomCode == roomId && data.roomCode.size() >= 4 && data.roomCode.size() <= 24
        && (!('matchId' in data) || data.matchId == null || (data.matchId is string && data.matchId.size() <= 32))
        && (!('roomName' in data) || (data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 80))
        && (!('mode' in data) || (data.mode in ['2v2', '4v4']))
        && (!('visibility' in data) || (data.visibility in ['public', 'private']))
        && (!('hasPassword' in data) || (data.hasPassword is bool))
        && (!('passwordHash' in data) || data.passwordHash == null || (data.passwordHash is string && data.passwordHash.size() <= 128))
        && (!('maxHumans' in data) || isValidNumberInRange(data.maxHumans, 1, 8))
        && (!('autoFillBots' in data) || (data.autoFillBots is bool))
        && (!('activeCharacterIds' in data) || (data.activeCharacterIds is list && data.activeCharacterIds.size() >= 1 && data.activeCharacterIds.size() <= 8))
        && (!('loadingReadyUids' in data) || (data.loadingReadyUids is list && data.loadingReadyUids.size() <= 16))
        && (!('startAt' in data) || data.startAt == null || isValidNumberInRange(data.startAt, 0, 99999999999999))
        && (!('lastActivityMs' in data) || isValidNumberInRange(data.lastActivityMs, 0, 99999999999999))
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 32
        && data.status in ['waiting', 'starting', 'playing', 'finished']
        && data.homeTeamId is string && data.homeTeamId.size() >= 1 && data.homeTeamId.size() <= 64
        && data.awayTeamId is string && data.awayTeamId.size() >= 1 && data.awayTeamId.size() <= 64
        && isValidNumberInRange(data.homeGoals, 0, 99)
        && isValidNumberInRange(data.awayGoals, 0, 99)
        && data.half in [1, 2]
        && isValidNumberInRange(data.remainingSeconds, 0, 3600)
        && data.slots is map && data.slots.size() <= 16
        && (!('inputs' in data) || (data.inputs is map && data.inputs.size() <= 16))
        && (!('matchSnapshot' in data) || data.matchSnapshot == null || data.matchSnapshot is map)
        && isValidTimestampOrInt(data.updatedAt)
        && isValidTimestampOrInt(data.createdAt);
    }

    function isValidMultiplayerMatch(data, matchId) {
      return data.keys().hasAll([
          'matchId', 'roomId', 'hostId', 'mode', 'status',
          'players', 'bots', 'score', 'startAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'matchId', 'roomId', 'hostId', 'mode', 'status',
          'players', 'bots', 'score', 'ball', 'startAt', 'createdAt', 'updatedAt'
        ])
        && data.matchId is string && data.matchId == matchId && data.matchId.size() >= 4 && data.matchId.size() <= 32
        && data.roomId is string && data.roomId.size() >= 4 && data.roomId.size() <= 24
        && data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128
        && data.mode in ['2v2', '4v4']
        && data.status in ['waiting', 'starting', 'playing', 'finished']
        && data.players is list && data.players.size() <= 16
        && data.bots is list && data.bots.size() <= 16
        && data.score is map
        && (!('ball' in data) || data.ball == null || data.ball is map)
        && isValidNumberInRange(data.startAt, 0, 99999999999999)
        && isValidTimestampOrInt(data.createdAt)
        && isValidTimestampOrInt(data.updatedAt);
    }

    function isValidVoiceSignal(data) {
      return data.keys().hasAll(['fromUid', 'toUid', 'type', 'payload', 'createdAt'])
        && data.keys().hasOnly(['fromUid', 'toUid', 'type', 'payload', 'createdAt'])
        && data.fromUid is string && data.fromUid == request.auth.uid && data.fromUid.size() <= 128
        && data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128
        && data.type in ['offer', 'answer', 'ice']
        && data.payload is string && data.payload.size() >= 2 && data.payload.size() <= 16384
        && isValidTimestampOrInt(data.createdAt);
    }

    function isValidFriendRequest(data) {
      return data.keys().hasAll([
          'fromUid', 'fromName', 'fromTag', 'toUid', 'toName',
          'type', 'roomCode', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fromUid', 'fromName', 'fromTag', 'toUid', 'toName',
          'type', 'roomCode', 'status', 'createdAt', 'updatedAt'
        ])
        && data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128
        && data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 64
        && data.fromTag is string && data.fromTag.size() >= 1 && data.fromTag.size() <= 24
        && data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128
        && data.toName is string && data.toName.size() >= 1 && data.toName.size() <= 64
        && data.fromUid != data.toUid
        && data.type in ['friend_request', 'room_invite']
        && data.roomCode is string && data.roomCode.size() <= 24
        && data.status in ['pending', 'accepted', 'declined']
        && isValidTimestampOrInt(data.createdAt)
        && isValidTimestampOrInt(data.updatedAt);
    }

    function isValidMatchHistory(data) {
      return data.keys().hasAll([
          'roomCode', 'hostUid', 'homeTeamName', 'awayTeamName',
          'homeGoals', 'awayGoals', 'winner', 'participantUids', 'createdAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'hostUid', 'homeTeamName', 'awayTeamName',
          'homeGoals', 'awayGoals', 'winner', 'participantUids', 'createdAt'
        ])
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 24
        && data.hostUid is string && data.hostUid == request.auth.uid
        && data.homeTeamName is string && data.homeTeamName.size() >= 1 && data.homeTeamName.size() <= 64
        && data.awayTeamName is string && data.awayTeamName.size() >= 1 && data.awayTeamName.size() <= 64
        && isValidNumberInRange(data.homeGoals, 0, 99)
        && isValidNumberInRange(data.awayGoals, 0, 99)
        && data.winner in ['home', 'away', 'draw']
        && data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 16
        && isValidTimestampOrInt(data.createdAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. User Profiles
    match /users/{userId} {
      allow get, list: if isAuthenticated();

      allow create: if isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (
          // Self update: owner can normalize legacy profiles while keeping uid immutable
          isOwner(userId)
          && isValidUserProfile(incoming(), userId)
          && (!('uid' in existing()) || incoming().uid == existing().uid)
          && (!('tagCode' in existing()) || incoming().tagCode == existing().tagCode || isOwner(userId))
          && incoming().updatedAt == request.time
        ) || (
          // Mutual friend acceptance update: another user can only append/remove their own UID in `friends`
          isAuthenticated()
          && incoming().diff(existing()).affectedKeys().hasOnly(['friends', 'updatedAt'])
          && incoming().friends is list && incoming().friends.size() <= 500
          && incoming().updatedAt == request.time
        );

      allow delete: if isOwner(userId);
    }

    // 2. Multiplayer Rooms
    match /rooms/{roomId} {
      allow get, list: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidMultiplayerRoom(incoming(), roomId)
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().homeGoals == 0
        && incoming().awayGoals == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAuthenticated()
        && isValidMultiplayerRoom(incoming(), roomId)
        && existing().status != 'finished'
        && incoming().roomCode == existing().roomCode
        && incoming().updatedAt == request.time
        && (
          // Host can update match state, scores, phase, or transfer host on leave
          existing().hostUid == request.auth.uid
          || (
            // Non-host participants can update slots (join/leave/ready/mic), inputs, loadingReadyUids, promote starting->playing, or inherit host on host timeout/exit
            incoming().homeGoals == existing().homeGoals
            && incoming().awayGoals == existing().awayGoals
            && incoming().homeTeamId == existing().homeTeamId
            && incoming().awayTeamId == existing().awayTeamId
          )
        );

      allow delete: if isAuthenticated();

      // WebRTC Voice Chat Signaling Subcollection
      match /signals/{signalId} {
        allow get, list: if isAuthenticated();

        allow create: if isAuthenticated()
          && isValidVoiceSignal(incoming())
          && incoming().createdAt == request.time;

        allow delete: if isAuthenticated()
          && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

        allow update: if false;
      }
    }

    // 2B. Multiplayer Active Matches
    match /matches/{matchId} {
      allow get, list: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidMultiplayerMatch(incoming(), matchId)
        && incoming().hostId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAuthenticated()
        && isValidMultiplayerMatch(incoming(), matchId)
        && incoming().matchId == existing().matchId
        && incoming().roomId == existing().roomId
        && incoming().updatedAt == request.time;

      allow delete: if isAuthenticated();
    }

    // 3. Friend Requests & Room Invites
    match /friendRequests/{requestId} {
      allow get: if isAuthenticated()
        && (resource == null || existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow list: if isAuthenticated()
        && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);

      allow create: if isAuthenticated()
        && isValidFriendRequest(incoming())
        && incoming().fromUid == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().toUid));

      allow update: if isAuthenticated()
        && isValidFriendRequest(incoming())
        && existing().status in ['pending', 'accepted']
        && incoming().fromUid == existing().fromUid
        && incoming().toUid == existing().toUid
        && incoming().updatedAt == request.time
        && (
          // Recipient accepts or declines
          (existing().toUid == request.auth.uid && incoming().status in ['accepted', 'declined'])
          ||
          // Sender cancels (declined)
          (existing().fromUid == request.auth.uid && incoming().status == 'declined')
        );

      allow delete: if isAuthenticated()
        && (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    // 4. Match History
    match /matchHistory/{matchId} {
      allow get, list: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidMatchHistory(incoming())
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
